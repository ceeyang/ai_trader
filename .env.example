# ai_trader 环境变量样例。复制为 `.env` 后按需修改；嵌套字段用双下划线 `__` 分隔
# （如 `RISK__MAX_LEVERAGE`）。本文件只给出默认值，不含任何真实密钥。
#
# 默认全部指向币安 USDT 本位合约测试网，可空仓直接运行 `uv run ai-trader probe`。
# 只要 REST/WS 端点不是测试网域名（含 BINANCE_REST_URL/BINANCE_WS_URL 覆盖），`run` 就必须加 `--confirm-mainnet`，
# 见 README「主网启用步骤与警告」一节。

# ---- 币安 API（测试网在 https://testnet.binancefuture.com 申请） ----------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true=测试网，false=主网（本机网络不可达主网域名，需海外服务器/代理）
BINANCE_TESTNET=true

# 留空按 BINANCE_TESTNET 自动推导：
#   测试网 REST https://testnet.binancefuture.com  WS wss://stream.binancefuture.com
#   主网   REST https://fapi.binance.com            WS wss://fstream.binance.com
BINANCE_REST_URL=
BINANCE_WS_URL=

# ---- 交易标的与模式 ---------------------------------------------------------
SYMBOLS=["BTCUSDT","ETHUSDT"]
LEVERAGE=2
# ISOLATED | CROSSED
MARGIN_TYPE=ISOLATED
# paper（真实测试网行情 + 模拟成交） | live（真实下单）
MODE=paper

# ---- 存储与日志 -------------------------------------------------------------
DB_PATH=data/ai_trader.db
LOG_LEVEL=INFO
LOG_JSON=false

# ---- DeepSeek（情绪分类器；留空则只用关键词兜底分类器） ------------------------
DEEPSEEK_API_KEY=

# ---- RISK：风控引擎（AutoTuner 永不修改这组参数） -----------------------------
RISK__MAX_LEVERAGE=3
RISK__MAX_ORDER_NOTIONAL_USDT=200
RISK__MAX_TOTAL_EXPOSURE_USDT=500
RISK__MAX_OPEN_POSITIONS=2
RISK__MAX_DAILY_LOSS_PCT=5
RISK__MAX_CONSECUTIVE_LOSSES=3
RISK__MAX_DATA_STALENESS_S=10.0
RISK__TRADING_ENABLED=true

# ---- STRATEGY：信号聚合与下单策略（AutoTuner 会自动调整部分字段） ---------------
STRATEGY__ENTRY_THRESHOLD=0.6
STRATEGY__EXIT_THRESHOLD=0.4
STRATEGY__BASE_NOTIONAL_USDT=100
STRATEGY__COOLDOWN_S=900
STRATEGY__STOP_LOSS_PCT=0.01
STRATEGY__TAKE_PROFIT_PCT=0.02
STRATEGY__MAX_HOLD_S=14400
STRATEGY__SIGNAL_HALF_LIFE_S=1800
# news_sentiment = DeepSeek 判断的新闻；news_keyword = 关键词分类器（含 DeepSeek 失败兜底）判断的新闻
STRATEGY__DETECTOR_WEIGHTS={"funding_extreme":0.5,"liquidation_burst":0.7,"news_sentiment":1.0,"news_keyword":0.5,"breakout":0.8,"mean_reversion":0.6}

# ---- DETECTORS：纯行情 / 新闻探测器阈值（AutoTuner 会自动调整） -----------------
DETECTORS__FUNDING_ANNUALIZED_THRESHOLD=0.30
DETECTORS__LIQUIDATION_WINDOW_S=300
DETECTORS__LIQUIDATION_NOTIONAL_THRESHOLD_USDT=50000
DETECTORS__LIQUIDATION_COOLDOWN_S=900
DETECTORS__NEWS_MIN_CONFIDENCE=0.6
# 突破探测器（已收盘 1m K 线）：回看根数、放量倍数、突破幅度 %、信号有效期、冷却
DETECTORS__BREAKOUT_LOOKBACK=60
DETECTORS__BREAKOUT_VOLUME_MULT=1.5
DETECTORS__BREAKOUT_MIN_MOVE_PCT=0.15
DETECTORS__BREAKOUT_TTL_S=1800
DETECTORS__BREAKOUT_COOLDOWN_S=900
# 均值回归探测器（收盘价 z-score）：回看根数、入场 |z|、信号有效期、冷却
DETECTORS__MR_LOOKBACK=30
DETECTORS__MR_Z_ENTRY=2.5
DETECTORS__MR_TTL_S=1200
DETECTORS__MR_COOLDOWN_S=900

# ---- NEWS：RSS（免费）与 X API v2（按量付费，$0.005/条，带每日预算） ------------
NEWS__RSS_FEEDS=["https://www.coindesk.com/arc/outboundfeeds/rss/","https://cointelegraph.com/rss"]
NEWS__RSS_POLL_INTERVAL_S=300
NEWS__X_BEARER_TOKEN=
NEWS__X_QUERY=(from:binance OR from:cz_binance OR from:coinbase OR from:SECGov OR from:federalreserve) -is:retweet
NEWS__X_POLL_INTERVAL_S=120
NEWS__X_MAX_RESULTS=10
# 2000 条/天 ≈ 10 美元/天上限，按需调低
NEWS__X_DAILY_READ_BUDGET=2000
# 发布时间早于 now - 此值（秒）的新闻只入库，不分类、不产生信号（节省 DeepSeek 预算）
NEWS__MAX_NEWS_AGE_S=7200

# ---- LLM：DeepSeek 情绪分类器（失败自动退化为关键词分类器） --------------------
LLM__ENABLED=true
# deepseek | none
LLM__PROVIDER=deepseek
LLM__MODEL=deepseek-chat
LLM__BASE_URL=https://api.deepseek.com
LLM__DAILY_CALL_BUDGET=500
LLM__MAX_TEXT_CHARS=4000
LLM__TIMEOUT_S=30.0
